# Electrical Drawing Analysis App - Environment Configuration

# =============================================================================
# API Keys (Required)
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here  
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_PASSWORD=electrical_password
DATABASE_URL=postgresql://electrical_user:electrical_password@postgres:5432/electrical_drawing_app

# Development Database (for docker-compose.dev.yml)
DEV_DATABASE_URL=postgresql://dev_user:dev_password@postgres:5433/electrical_drawing_app_dev

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379

# =============================================================================
# Service Configuration
# =============================================================================

# File Processor Service
FILE_PROCESSOR_PORT=3001
STORAGE_BASE=/app/storage
UPLOAD_DIR=/app/uploads
TEMP_FILE_EXPIRY_HOURS=24

# LLM Orchestrator Service  
LLM_ORCHESTRATOR_PORT=3002

# Memory Service
MEMORY_SERVICE_PORT=8002
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# =============================================================================
# Application Configuration
# =============================================================================

# Environment
NODE_ENV=production
LOG_LEVEL=info

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Session Configuration
SESSION_SECRET=your-session-secret-here
JWT_SECRET=your-jwt-secret-here

# =============================================================================
# Shared Storage Configuration  
# =============================================================================

# Base path for shared session storage
SHARED_SESSIONS_PATH=${PWD}/backend/services/file-processor/backend/storage/sessions

# File uploads path
UPLOADS_PATH=${PWD}/backend/services/file-processor/uploads

# =============================================================================
# Development Configuration
# =============================================================================

# Debug settings (for development)
DEBUG=electrical:*
HOT_RELOAD=true
DEVELOPMENT_MODE=true

# =============================================================================
# Security Configuration
# =============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=50MB
MAX_FILES_PER_REQUEST=10

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Performance thresholds
PERFORMANCE_THRESHOLD_MS=100
STORAGE_ALERT_THRESHOLD=0.8

# Health check intervals  
HEALTH_CHECK_INTERVAL_MS=30000

# =============================================================================
# Docker Configuration
# =============================================================================

# Container resource limits
FILE_PROCESSOR_MEMORY=1g
LLM_ORCHESTRATOR_MEMORY=2g
POSTGRES_MEMORY=512m
REDIS_MEMORY=256m

# Network configuration
DOCKER_NETWORK=172.20.0.0/16